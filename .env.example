# Back-office API access.
# Copy this file to .env locally and fill values there.
# Do not paste real tokens into documentation or chat.

# Teplo app runtime.
DATABASE_URL=postgresql+asyncpg://teplo:teplo@localhost:5432/teplo
JWT_SECRET_KEY=change-me-in-local-env-change-me
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174"]
VITE_API_BASE_URL=http://localhost:8000

BACKOFFICE_API_BASE_URL=
BACKOFFICE_API_TOKEN=

# Optional: if the API uses login/password instead of token.
BACKOFFICE_API_LOGIN=
BACKOFFICE_API_PASSWORD=

# iikoServer API. Secrets are read by scripts/iiko/export_employees.py and the
# backend staff sync service; use either a token or login + password/password SHA1.
IIKO_SERVER_BASE_URL=
IIKO_SERVER_TOKEN=
IIKO_SERVER_LOGIN=
IIKO_SERVER_PASSWORD=
IIKO_SERVER_PASSWORD_SHA1=
IIKO_SERVER_TIMEOUT_SECONDS=90
EMPLOYEE_SYNC_ENABLED=true
EMPLOYEE_SYNC_INTERVAL_HOURS=6

# Google Drive is accessed through the Codex Google Drive connector.
# Store important folder/file IDs here only if needed for scripts.
GOOGLE_DRIVE_MANAGEMENT_FOLDER_URL=
GOOGLE_DRIVE_DDS_SPREADSHEET_URL=https://docs.google.com/spreadsheets/d/1eUSBGOnYzieWZ2J8qEwxmXlAAOCoLMZnpvzb91EvQ_I/edit
GOOGLE_DRIVE_PNL_SPREADSHEET_URL=https://docs.google.com/spreadsheets/d/1X3srrLjpS4isiWzCVZ-jDhqqLL7tNx5TznXZRoDhbZo/edit
GOOGLE_DRIVE_BALANCE_SPREADSHEET_URL=https://docs.google.com/spreadsheets/d/1ekjJSe8Rt7IROfBVYhqZSkvwG1FnUycCPaUM4w9xqsE/edit

GOOGLE_DRIVE_PAYROLL_SPREADSHEET_URL=https://docs.google.com/spreadsheets/d/1ribsb9A64-9OvkMxJisyMZtjLQT_gLCET40G8cYzD4Q/edit
GOOGLE_DRIVE_COURIER_SCHEDULE_SPREADSHEET_URL=https://docs.google.com/spreadsheets/d/1trSTDaGAZXPODj7ntFep6Hwu_V2r0BISKGV_xENu4a0/edit

# Saby/SBIS EDO DocsInbox API access.
# Use a service app with read-only permissions for incoming EDO documents.
SBIS_API_BASE_URL=https://online.sbis.ru
SBIS_APP_CLIENT_ID=
SBIS_APP_SECRET=
SBIS_SECRET_KEY=
SBIS_OUR_ORG_INN=
SBIS_OUR_ORG_KPP=

# Sber API access.
# Fill only in local .env; do not commit real tokens or client secrets.
SBER_API_BASE_URL=
SBER_API_AUTH_BASE_URL=
SBER_API_AUTHORIZE_URL=
SBER_API_TOKEN_URL=
SBER_API_SERVICE_NAME=
SBER_API_CLIENT_ID=
SBER_API_CLIENT_SECRET=
SBER_API_REDIRECT_URI=
SBER_API_SCOPE=
SBER_API_SCOPE_V1=
SBER_API_SCOPE_V2=
SBER_API_ACCESS_TOKEN=
SBER_API_REFRESH_TOKEN=
SBER_API_ACCOUNT_NUMBER=
SBER_API_TIMEOUT_SECONDS=
SBER_API_CA_BUNDLE_PATH=
SBER_API_TLS_P12_PATH=
SBER_API_TLS_P12_PASSWORD=
SBER_API_TLS_CERT_PATH=
SBER_API_TLS_KEY_PATH=

# T-Bank Business Open API access.
# Read-only token scopes only: account info + company operations.
TBANK_API_BASE_URL=
TBANK_API_ACCESS_TOKEN=
TBANK_API_ACCOUNT_NUMBER=
TBANK_API_TIMEOUT_SECONDS=
TBANK_API_RATE_LIMIT_PER_SECOND=
TBANK_API_ORGANIZATION_INN=
TBANK_API_ORGANIZATION_KPP=
TBANK_API_WEBHOOK_URL=
TBANK_API_WEBHOOK_SECRET=

# T-Bank payment order automation.
# Goal: place recognized payments into "Платежи в работе -> На подпись".
# Requires a separate T-API H2H setup: payment-order scope, mTLS certificate,
# and cryptographic signature credentials. Keep disabled until owner approves.
TBANK_API_PAYMENT_ORDER_ENABLED=false
TBANK_API_PAYMENT_ORDER_BASE_URL=https://secured-openapi.tbank.ru
TBANK_API_PAYMENT_ORDER_TOKEN=
TBANK_API_PAYMENT_ORDER_ACCOUNT_NUMBER=
TBANK_API_PAYMENT_ORDER_TIMEOUT_SECONDS=
TBANK_API_PAYMENT_ORDER_TLS_CERT_PATH=
TBANK_API_PAYMENT_ORDER_TLS_KEY_PATH=
TBANK_API_PAYMENT_ORDER_CA_BUNDLE_PATH=
TBANK_API_PAYMENT_ORDER_SIGNATURE_KEY_ID=
TBANK_API_PAYMENT_ORDER_SIGNATURE_SECRET=
TBANK_API_PAYMENT_ORDER_SIGNATURE_SECRET_ENCODING=raw
TBANK_API_PAYMENT_ORDER_SIGNATURE_HEADERS=request-target date data
TBANK_API_PAYMENT_ORDER_SIGNATURE_ENCODING=base64
TBANK_API_PAYMENT_ORDER_DATA_ENCODING=base64

# Fallback only: creates regular bank drafts under "Черновики -> Платежи".
TBANK_API_PAYMENT_DRAFT_ENABLED=false
TBANK_API_PAYMENT_DRAFT_BASE_URL=https://business.tbank.ru/openapi
TBANK_API_PAYMENT_DRAFT_TOKEN=
TBANK_API_PAYMENT_DRAFT_ACCOUNT_NUMBER=
TBANK_API_PAYMENT_DRAFT_TIMEOUT_SECONDS=

# Utility payments destination — owner's personal T-Bank card.
# Water/electricity payments are routed to the owner's card (compensation pattern):
# company transfers the bill amount to the card, owner pays the utility separately.
# Card number is used only for display masking; the actual API call needs
# agreementNumber (T-Bank contract number for the card, found in T-Business UI
# → карта → Реквизиты → Номер договора). Until agreement is set, soft-submit only.
TBANK_API_PERSONAL_CARD_NUMBER=
TBANK_API_PERSONAL_CARD_AGREEMENT=

# Mango Office personal cabinet (read-only browser scrape).
MANGO_OFFICE_LK_URL=
MANGO_OFFICE_LOGIN=
MANGO_OFFICE_PASSWORD=

# Mail.ru mailbox connector.
# Use an external application password with "Full mail access" (SMTP, IMAP, POP3).
MAILRU_EMAIL=
MAILRU_APP_PASSWORD=
MAILRU_WORKMAIL=
MAILRU_WORKMAIL_PASSWORD=
# Optional default account for mail commands: personal, workmail, or all for read-only commands.
MAILRU_ACCOUNT=personal
MAILRU_IMAP_HOST=imap.mail.ru
MAILRU_IMAP_PORT=993
MAILRU_SMTP_HOST=smtp.mail.ru
MAILRU_SMTP_PORT=465
MAIL_DB_PATH=data/private/mail/mail.sqlite3
MAIL_ATTACHMENTS_DIR=data/private/mail/attachments

# Telegram payment intake bot.
# Fill only in local .env. The bot only creates private intake candidates;
# it does not submit payments to T-Bank.
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_PAYMENT_BOT_ALLOWED_CHAT_IDS=
TELEGRAM_PAYMENT_BOT_ACCOUNT_NUMBER=
TELEGRAM_PAYMENT_BOT_MAX_FILE_MB=20
TELEGRAM_PAYMENT_BOT_POLL_TIMEOUT_SECONDS=50
