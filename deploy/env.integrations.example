# Production integration secrets template for first go-live.
# Copy to .env.integrations on the production host and fill there.
# Do NOT commit .env.integrations.

# --- iiko Server API ---
# The iiko client reads these values from env and obtains its own token.
IIKO_SERVER_BASE_URL=
IIKO_SERVER_LOGIN=
IIKO_SERVER_PASSWORD=
IIKO_SERVER_TIMEOUT_SECONDS=90

# --- T-Bank Business Open API ---
# TBANK_API_ACCESS_TOKEN is the shared bearer token for statements,
# account movement and payment draft creation.
TBANK_API_BASE_URL=https://business.tbank.ru/openapi
TBANK_PAYMENT_BASE_URL=https://secured-openapi.tbank.ru
TBANK_API_ACCESS_TOKEN=
TBANK_API_ACCOUNT_NUMBER=
TBANK_API_TIMEOUT_SECONDS=90

# --- Sber Fintech API (mTLS) ---
# Statement/transactions sync runs through the SAME movement pipeline as T-Bank
# (выписка → bank_operations → классификация → cashflow → баланс от движений),
# not a balance poll. The cert/key/CA files are copied into secrets/sber/ by
# build_integrations_env.py and these three *_PATH values are rewritten to
# /run/secrets/teplo/sber/<file> automatically.
SBER_API_BASE_URL=https://fintech.sberbank.ru:9443/fintech/api
SBER_API_TOKEN_URL=https://fintech.sberbank.ru:9443/ic/sso/api/v2/oauth/token
SBER_API_CLIENT_ID=
SBER_API_CLIENT_SECRET=
SBER_API_ACCOUNT_NUMBER=
SBER_API_ACCESS_TOKEN=
SBER_API_REFRESH_TOKEN=
SBER_API_TLS_CERT_PATH=
SBER_API_TLS_KEY_PATH=
SBER_API_CA_BUNDLE_PATH=
# To turn the provider on, set BANK_SYNC_PROVIDERS=sber,tbank in .env.prod (NOT here:
# this rendered file is loaded after .env.prod and an empty value would override it).
# Flip it on only once the Sber secrets above are in place.

# Optional integrations such as Mango, Mail.ru and Telegram are not part of the
# first go-live secret set. Add their variables only when enabled.
