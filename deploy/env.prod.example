# Production environment template.
# Copy to .env.prod and fill in actual values. Do NOT commit .env.prod.

# --- Domain (used by Caddy for automatic Let's Encrypt SSL) ---
TEPLO_DOMAIN=app.example.com

# --- Runtime mode ---
ENVIRONMENT=production
AUTH_COOKIE_SECURE=true

# --- Postgres ---
POSTGRES_DB=teplo
POSTGRES_USER=teplo
POSTGRES_PASSWORD=replace-with-strong-random-password

# --- Application admin (created on first start) ---
TEPLO_ADMIN_EMAIL=admin@teplo.local
TEPLO_ADMIN_PASSWORD=replace-with-strong-random-password

# --- JWT (rotate if leaked) ---
JWT_SECRET_KEY=replace-with-at-least-64-random-hex-chars
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=90

# --- T-Bank "payment status" webhook (incoming bank -> us) ---
# Our own shared secret: the bank sends it as `Authorization: Bearer`. The webhook mutates
# financial state (settles and rolls back invoices), and IP filtering behind a proxy is not
# trustworthy, so this token is the actual protection.
# REQUIRED in production: without it Settings validation fails at import time and neither
# api nor scheduler starts. init-prod-env.sh generates one; hand the value to the bank when
# the webhook is enabled (openapi@tbank.ru).
TBANK_WEBHOOK_TOKEN=replace-with-random-hex-token
# Optional CSV whitelist of the bank's source IPs; empty disables the check.
TBANK_WEBHOOK_ALLOWED_IPS=

# --- CORS allowed origins (JSON array). For same-origin SPA leave empty. ---
BACKEND_CORS_ORIGINS=[]

# --- Bank sync ---
TEPLO_BANK_CLIENT_MODE=live
# Which providers the scheduler polls (CSV). Sber joins only once its secrets are in place:
# `sber,tbank` also makes check-prod-secrets.sh demand the whole SBER_API_* set. This belongs
# here and NOT in .env.integrations — that file is rendered line by line and is loaded last,
# so an empty value there would override whatever is set in this file.
BANK_SYNC_PROVIDERS=tbank

# Everything below is read from THIS file only. deploy/scripts/build_integrations_env.py owns
# IIKO_*/TBANK_*/SBER_* and renders .env.integrations from its own template; a key put there
# without a local value is deployed EMPTY and overrides this file (the rendered file is loaded
# after it). None of the values below stop the containers from starting — they switch whole
# features on and off, mostly silently, so an empty value here is a decision, not an oversight.

# --- Claude (invoice recognition, tax AI review, fixed-asset revaluation) ---
# Without the key the deterministic layer still runs: PDF invoices are parsed by regex only and
# anything below the confidence threshold waits for an operator (app/services/invoice_recognition.py),
# while «ИИ-разбор»/«ИИ-ревизия» in Налоги and the fixed-asset condition endpoint answer 422 and
# the revaluation job marks its records failed.
ANTHROPIC_API_KEY=
# Relay base URL. From a Russian IP Anthropic answers 403 «Request not allowed» even to a valid
# key (verified on prod 2026-07-27), so the key alone is not enough: requests go through the
# Cloudflare worker in deploy/anthropic-relay-worker.js. The SDK reads this variable itself —
# Settings does not carry it — so it must be present in the container environment, i.e. here.
# The alternative is an HTTPS_PROXY that reaches an allowed region.
ANTHROPIC_BASE_URL=
# Shared password of that relay (sent as the x-relay-secret header). The worker answers 403 to
# anyone whose header does not match, so with a relay URL set this value is not optional: every
# model call fails, and the failure looks like a bad API key.
ANTHROPIC_RELAY_SECRET=

# --- Mail.ru mailboxes (incoming invoices and the accountant's tax documents) ---
# Both pollers walk both mailboxes; a mailbox is used only when its login AND password are set
# (app/services/mail/imap_client.py). With none set both jobs return "not_configured" and the
# scheduler does not even log it: «Страница на оплату» and the tax staging stay empty in silence.
# The password is an application password ("Full mail access"), not the account password.
MAILRU_EMAIL=
MAILRU_APP_PASSWORD=
MAILRU_WORKMAIL=
MAILRU_WORKMAIL_PASSWORD=
# Turn the pollers off explicitly when the contour is deliberately not in use — that is the
# difference between "off on purpose" and "configured wrong".
MAIL_POLL_ENABLED=true
TAX_DOCUMENT_POLL_ENABLED=true
# Senders whose attachments count as tax documents (CSV). Empty falls back to the accountant
# from the methodology (app/services/taxes/document_ingest.py: DEFAULT_TAX_SENDERS), so this
# only needs a value when the accountant changes. Mail from any other sender is dropped silently.
TAX_DOCUMENT_SENDERS=askad02@mail.ru

# --- Telegram intake bot: utility receipts forwarded from the messenger ---
# The landlords send water/gas/electricity papers in Telegram; the owner forwards them to the
# bot and the file goes through the same door as the «Загрузить документ» button on the payment
# page (app/services/telegram_intake.py). Empty token = the contour is off and the job returns
# "not_configured" without logging.
TELEGRAM_INTAKE_BOT_TOKEN=
# There is no allow-list of chats (owner's call, 02.08.2026): a document is accepted from anyone
# who writes to the bot, and every intake row remembers the sender (name and chat id land in the
# "from" column of the payment page), so "whose document is this" always has an answer.
# Turn the poller off explicitly when the contour is deliberately not in use. Never run the
# retired integrations/tbank/scripts/payment_order_bot.py with the same token: Telegram lets
# only ONE consumer read getUpdates, and the second one steals messages silently.
TELEGRAM_INTAKE_ENABLED=true

# --- SBIS (Saby) EDO: mirror of incoming documents ---
# Service authorisation of an external app (app_client_id + secret_key from the Saby cabinet).
# Without the pair the hourly sbis_document_sync job returns immediately and the manual
# «Синхронизировать» button answers 409 «СБИС не настроен» — the EDO mirror simply stays empty.
SBIS_APP_CLIENT_ID=
SBIS_SECRET_KEY=
SBIS_SYNC_ENABLED=true
