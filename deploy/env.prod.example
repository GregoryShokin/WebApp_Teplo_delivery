# Production environment template.
# Copy to .env.prod and fill in actual values. Do NOT commit .env.prod.

# --- Domain (used by Caddy for automatic Let's Encrypt SSL) ---
TEPLO_DOMAIN=app.example.com

# --- Runtime mode ---
ENVIRONMENT=production
AUTH_COOKIE_SECURE=true

# --- Postgres ---
POSTGRES_DB=teplo
POSTGRES_USER=teplo
POSTGRES_PASSWORD=replace-with-strong-random-password

# --- Application admin (created on first start) ---
TEPLO_ADMIN_EMAIL=admin@teplo.local
TEPLO_ADMIN_PASSWORD=replace-with-strong-random-password

# --- JWT (rotate if leaked) ---
JWT_SECRET_KEY=replace-with-at-least-64-random-hex-chars
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=90

# --- CORS allowed origins (JSON array). For same-origin SPA leave empty. ---
BACKEND_CORS_ORIGINS=[]

# --- Sber API (read-only banking integration) ---
TEPLO_BANK_CLIENT_MODE=live
