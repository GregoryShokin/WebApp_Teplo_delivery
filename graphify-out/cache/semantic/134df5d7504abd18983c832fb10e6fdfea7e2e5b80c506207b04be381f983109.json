e\u0442\u043e\u043a\u043e\u043c 33\u219252\u219290 \u043c\u0438\u043d (\u043a\u043e\u0440\u0440. 0,30), \u0434\u043e\u0440\u043e\u0433\u0430 \u043f\u043b\u043e\u0441\u043a\u0430\u044f (0,10) \u2192 \u043f\u0435\u0440\u0435\u0433\u0440\u0443\u0437 \u043f\u0440\u043e\u043f\u0443\u0441\u043a\u043d\u043e\u0439 \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438, \u043d\u0435 \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d\u0430 \u0438 \u043d\u0435 \u043a\u0443\u0440\u044c\u0435\u0440."}, {"id": "marketing_operating_constraints_plan_p0_p3", "label": "\u0415\u0434\u0438\u043d\u044b\u0439 \u043f\u043b\u0430\u043d \u041f0\u2013\u041f3 (\u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442 \u043f\u043e \u0437\u0430\u0442\u0440\u0430\u0442\u0430\u043c)", "file_type": "concept", "source_file": "business-docs/marketing/operating-constraints.md", "source_location": "\u00a79", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u0414\u0438\u0441\u043a\u0443\u0441\u0441\u0438\u044f \u00ab\u0447\u0438\u043d\u0438\u0442\u044c \u0438\u0441\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u0435 vs \u043f\u0440\u0438\u043d\u044f\u0442\u044c \u0438 \u043f\u0435\u0440\u0435\u0438\u0433\u0440\u0430\u0442\u044c\u00bb \u0441\u043e\u0448\u043b\u0430\u0441\u044c \u043d\u0430 \u043e\u0434\u043d\u043e\u043c \u043f\u043b\u0430\u043d\u0435: \u041f0 \u2014 0 \u20bd \u0445\u0440\u043e\u043d\u043e\u043c\u0435\u0442\u0440\u0430\u0436 \u043f\u0438\u043a\u0430 \u0433\u0435\u0439\u0442\u0438\u0442 \u0432\u0441\u0451; \u0447\u0438\u043d\u0438\u0442\u044c \u0434\u0435\u0448\u0451\u0432\u044b\u0435 \u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b\u044b, \u043d\u0435 \u0433\u043e\u0442\u043e\u0432\u043a\u0443."}, {"id": "marketing_operating_constraints_produktovyy_khedzh", "label": "\u041f\u0440\u043e\u0434\u0443\u043a\u0442\u043e\u0432\u044b\u0439 \u0445\u0435\u0434\u0436: \u043f\u0438\u0446\u0446\u0430 + \u0441\u0435\u043c\u0435\u0439\u043d\u044b\u0