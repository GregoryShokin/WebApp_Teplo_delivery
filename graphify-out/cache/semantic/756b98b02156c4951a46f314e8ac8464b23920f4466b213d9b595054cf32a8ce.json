uthor": null, "contributor": null}, {"id": "deploy_docker_compose_prod_telegram_extra_hosts_pin", "label": "\u041f\u0438\u043d api.telegram.org \u043d\u0430 149.154.167.220", "file_type": "rationale", "source_file": "deploy/docker-compose.prod.yml", "source_location": "deploy/docker-compose.prod.yml:56", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u0423 \u0445\u043e\u0441\u0442\u0438\u043d\u0433-\u043f\u0440\u043e\u0432\u0430\u0439\u0434\u0435\u0440\u0430 \u0434\u043e\u0441\u0442\u0443\u043f\u0435\u043d \u041d\u0415 \u0412\u0415\u0421\u042c Telegram: DNS (\u043b\u043e\u043a\u0430\u043b\u044c\u043d\u044b\u0439 \u0440\u0435\u0437\u043e\u043b\u0432\u0435\u0440, 1.1.1.1, 8.8.8.8) \u043e\u0442\u0434\u0430\u0451\u0442 149.154.166.110, \u0430 \u0434\u043e \u044d\u0442\u043e\u0433\u043e \u0430\u0434\u0440\u0435\u0441\u0430 \u0441 \u0441\u0435\u0440\u0432\u0435\u0440\u0430 \u043d\u0435\u0442 \u0441\u0432\u044f\u0437\u0438 \u2014 TCP 443 \u0437\u0430\u043a\u0440\u044b\u0442, \u043e\u043f\u0440\u043e\u0441 \u0431\u043e\u0442\u0430 \u043f\u0430\u0434\u0430\u043b ConnectTimeout \u043a\u0430\u0436\u0434\u044b\u0435 \u043f\u043e\u043b\u043c\u0438\u043d\u0443\u0442\u044b. \u0410\u0434\u0440\u0435\u0441 149.154.167.220 \u0438\u0437 \u0442\u043e\u0439 \u0436\u0435 \u0441\u0435\u0442\u0438 \u0436\u0438\u0432 (getMe \u043e\u0442\u0432\u0435\u0447\u0430\u0435\u0442 200). \u041f\u0438\u043d \u0447\u0435\u0440\u0435\u0437 extra_hosts \u0432\u044b\u0431\u0440\u0430\u043d \u043a\u0430\u043a \u0441\u0430\u043c\u043e\u0435 \u0434\u0435\u0448\u0451\u0432\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435; \u0435\u0441\u043b\u0438 \u0437\u0430\u043a\u0440\u043e\u044e\u0442 \u0438 \u0435\u0433\u043e, \u043a\u043e\u043d\u0442\u0443\u0440 \u0432\u0441\u0442\u0430\u043d\u0435\u0442 \u0441 \u0442\u0435\u043c \u0436\u0435 \u044f\u0432\u043d\u044b\u043c ConnectTimeout \u0432 \u043b\u043e\u0433\u0430\u0445, \u0430 \u043d\u0435 \u043c\u043e\u043b\u0447\u0430 \u2014 \u043e\u0442\u043a\u0430\u0437 \u043e\u0441\u0442\u0430\u0451\u0442\u0441\u044f \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0440\u0443\u0435\u043c\u044b\u043c."}, {"id": "deploy_docker_compose_prod_scheduler_healthcheck_disabled", "label": "healthcheck.disable \u0434\u043b\u044f scheduler", "file_type": "rationale", "source_file": "deploy/docker-compose.prod.yml", "source_location": "deploy/docker-compose.prod.yml:48", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scheduler \u0441\u043e\u0431\u0438\u0440\u0430\u0435\u0442\u0441\u044f \u0438\u0437 \u0442\u043e\u0433\u043e \u0436\u0435 Dockerfile, \u0447\u0442\u043e \u0438 api, \u0438 \u043d\u0430\u0441\u043b\u0435\u0434\u0443\u0435\u0442 \u0435\u0433\u043e HTTP-healthcheck, \u043d\u043e HTTP-\u0441\u0435\u0440\u0432\u0435\u0440 \u043d\u0435 \u043f\u043e\u0434\u043d\u0438\u043c\u0430\u0435\u0442 \u2014 \u0443\u043d\u0430\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u043d\u0430\u044f \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0430 \u0432\u0441\u0435\u0433\u0434\u0430 \u043f\u0430\u0434\u0430\u0435\u0442 \u0438 \u043f\u043e\u043c\u0435\u0447\u0430\u0435\u0442 \u0436\u0438\u0432\u043e\u0439 \u043a\u043e\u043d\u0442\u0435\u0439\u043d\u0435\u0440 unhealthy. \u041f\u0440\u043e\u0432\u0435\u0440\u043a\u0430 \u043e\u0442\u043a\u043b\u044e\u0447\u0435\u043d\u0430 \u044f\u0432\u043d\u043e \u0432\u043c\u0435\u0441\u0442\u043e \u043f\u0435\u0440\u0435\u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044f."}, {"id": "deploy_docker_compose_prod_service_healthy_gate", "label": "depends_on: condition service_healthy (\u0433\u0435\u0439\u0442 \u0433\u043e\u0442\u043e\u0432\u043d\u043e\u0441\u0442\u0438 \u0411\u0414)", "file_type": "rationale", "source_file": "deploy/docker-compose.prod.yml", "source_location": "deploy/docker-compose.prod.yml:33", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "api \u0438