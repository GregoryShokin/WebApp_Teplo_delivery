40\u0438\u0433\u0433\u0435\u0440\u044b \u0437\u0430\u0449\u0438\u0449\u0430\u044e\u0442 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a."}, {"id": "changes_2026_11_01_asset_capitalization_dated_implementation", "label": "\u0420\u0435\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044f c2e4dbcb \u0438 \u043c\u0438\u0433\u0440\u0430\u0446\u0438\u044f 0282_asset_capitalization", "file_type": "concept", "source_file": "docs/changes/2026-11-01-asset-capitalization-dated.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "changes_2026_11_01_asset_capitalization_dated_authorized_deployment", "label": "\u0420\u0430\u0437\u0440\u0435\u0448\u0451\u043d\u043d\u0430\u044f \u0432\u043b\u0430\u0434\u0435\u043b\u044c\u0446\u0435\u043c \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0430 01.11.2026", "file_type": "concept", "source_file": "docs/changes/2026-11-01-asset-capitalization-dated.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u0420\u0430\u0437\u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u043d\u0430 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0443 \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u043e, \u0432\u0435\u0440\u0441\u0438\u044f \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0430. \u041e\u0442\u0434\u0435\u043b\u044c\u043d\u043e\u0439 \u043f\u0440\u0438\u0451\u043c\u043a\u0438 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0430 \u043d\u0430 \u0431\u043e\u044e \u0432\u043b\u0430\u0434\u0435\u043b\u044c\u0446\u0435\u043c \u043f\u043e\u043a\u0430 \u043d\u0435\u0442."}, {"id": "changes_2026_11_01_asset_capitalization_dated_deployed_verification", "label": "\u0417\u0430\u0432\u0435\u0440\u0448\u0451\u043d\u043d\u044b\u0435 \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0438 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u043e\u0439 \u0432\u0435\u0440\u0441\u0438\u0438", "file_type": "concept", "source_file": "docs/changes/2026-11-01-asset-capitalization-dated.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u0421\u043e\u0445\u0440\u0430\u043d\u043d\u043e\u0441\u0442\u044c 149 \u041e\u0421, 13 \u0441\u0432\u044f\u0437\u0435\u0439, 438 \u043d\u0430\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0439, 44 \u0441\u043d\u0438\u043c\u043a\u043e\u0432 \u0438 \u043e\u0442\u0447\u0451\u0442\u043e\u0432 \u0437\u0430 22 \u043c\u0435\u0441\u044f\u0446\u0430 \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0430 \u0441\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435\u043c \u0434\u043e/\u043f\u043e\u0441\u043b\u0435. \u041f\u043e\u043b\u043d\u044b\u0439 \u0441\u0446\u0435\u043d\u0430\u0440\u0438\u0439 \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u044f \u043f\u0440\u043e\u0432\u0435\u0440\u0435\u043d \u043d\u0430 \u043a\u043e\u043f\u0438\u0438."}, {"id": "changes_2026_11_01_asset_capitalization_dated_no_production_candidates", "label": "\u041d\u0430 \u0431\u043e\u044e \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u044e\u0442 \u043a\u0430\u043d\u0434\u0438\u0434\u0430\u0442\u044b \u043a\u0430\u043f\u0438\u0442\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0440\u0435\u043c\u043e\u043d\u0442\u0430", "file_type": "concept", "source_file": "docs/changes/2026-11-01-asset-capitalization-dated.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u0412\u0441\u0435 13 \u0431\u043e\u0435\u0432\u044b\u0445 \u0440\u0435\u043c\u043e\u043d\u0442\u043d\u044b\u0445 \u0441\u0432\u044f\u0437\u0435\u0439 \u043e\u0442\u043d\u043e\u0441\u044f\u0442\u0441\u044f \u043a maintenance. \u041f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u0439 \u043d\u0430 \u0431\u043e\u044e \u043d\u0435 \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u043b\u043e\u0441\u044c, \u0444\u0438\u043a\u0442\u0438\u