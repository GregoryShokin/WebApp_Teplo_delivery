38\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0430 \u0441\u043e\u0441\u0435\u0434\u0430: pgrep -fa pytest \u0438 pg_stat_activity", "file_type": "concept", "source_file": "apps/api/TESTING.md", "source_location": "L55-L76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pgrep \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442, \u0447\u0435\u0439 \u043f\u0440\u043e\u0446\u0435\u0441\u0441 \u0436\u0438\u0432 \u0438 \u0438\u0437 \u043a\u0430\u043a\u043e\u0439 \u043f\u0430\u043f\u043a\u0438; \u0437\u0430\u043f\u0440\u043e\u0441 \u043f\u043e pg_stat_activity \u0441 datname like 'teplo_test%' \u2014 \u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043a\u043e\u043d\u043d\u0435\u043a\u0442\u043e\u0432 \u0432 \u043a\u0430\u0436\u0434\u043e\u0439 \u0442\u0435\u0441\u0442\u043e\u0432\u043e\u0439 \u0431\u0430\u0437\u0435. \u041d\u0430\u0448\u0451\u043b\u0441\u044f \u0447\u0443\u0436\u043e\u0439 \u043f\u0440\u043e\u0446\u0435\u0441\u0441 \u2014 \u0431\u0430\u0437\u0443 \u043d\u0435 \u0442\u0440\u043e\u0433\u0430\u0442\u044c \u0432\u043e\u043e\u0431\u0449\u0435, \u0437\u0430\u0432\u0435\u0441\u0442\u0438 \u0441\u0432\u043e\u044e; \u0447\u0443\u0436\u043e\u0439 \u043f\u0440\u043e\u0433\u043e\u043d \u043f\u0440\u0438 \u044d\u0442\u043e\u043c \u0434\u043e\u0436\u0438\u0432\u0451\u0442 \u0434\u043e \u043a\u043e\u043d\u0446\u0430."}, {"id": "api_testing_schema_lifecycle", "label": "\u0416\u0438\u0437\u043d\u0435\u043d\u043d\u044b\u0439 \u0446\u0438\u043a\u043b \u0441\u0445\u0435\u043c\u044b: \u043f\u0435\u0440\u0435\u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435, alembic head, TRUNCATE \u043c\u0435\u0436\u0434\u0443 \u0442\u0435\u0441\u0442\u0430\u043c\u0438", "file_type": "concept", "source_file": "apps/api/TESTING.md", "source_location": "L62-L64", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u041f\u0435\u0440\u0435\u0434 test session \u0441\u0445\u0435\u043c\u0430 public \u043f