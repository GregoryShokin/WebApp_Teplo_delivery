{"nodes": [{"id": "decisions_database_decisions", "label": "Database architecture decisions (\u00a711/\u00a715)", "file_type": "document", "source_file": "app-spec/architecture/decisions/database-decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "decisions_database_decisions_counterparty_unified", "label": "\u0420\u0435\u0448\u0435\u043d\u0438\u0435 11.1: \u0435\u0434\u0438\u043d\u044b\u0439 counterparty + \u0440\u043e\u043b\u0438", "file_type": "rationale", "source_file": "app-spec/architecture/decisions/database-decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u0412\u0430\u0440\u0438\u0430\u043d\u0442 A + C12: \u043e\u0434\u0438\u043d \u0441\u043f\u0440\u0430\u0432\u043e\u0447\u043d\u0438\u043a aliases, supplier \u2014 \u0440\u043e\u043b\u044c/profile, \u043d\u0435 \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u0439 master."}, {"id": "decisions_database_decisions_dds_single_cashfact", "label": "\u0420\u0435\u0448\u0435\u043d\u0438\u0435 11.2: DDS \u2014 \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 cash-fact \u043e\u043f\u043b\u0430\u0442 \u043f\u043e\u0441\u0442\u0430\u0432\u0449\u0438\u043a\u0430\u043c", "file_type": "rationale", "source_file": "app-spec/architecture/decisions/database-decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u0423\u0414\u041a\u0417 \u0445\u0440\u0430\u043d\u0438\u0442 \u0442\u043e\u043b\u044c\u043a\u043e supplier_payment_match, \u0431\u0435\u0437 \u0441\u0432\u043e\u0435\u0433\u043e payment ledger."}, {"id": "decisions_database_decisions_centralized_audit", "label": "\u0420\u0435\u0448\u0435\u043d\u0438\u0435 11.3: \u0446\u0435\u043d\u0442\u0440\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043d\u043d\u044b\u0439 source_reference", "file_type": "rationale", "source_file": "app-spec/architecture/decisions/database-decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "balance_source_reference \u0443\u043f\u0440\u0430\u0437\u0434\u043d\u044f\u0435\u0442\u0441\u044f; \u0435\u0434\u0438\u043d\u044b\u0439 audit trail \u0434\u043b\u044f \u0432\u0441\u0435\u0445 \u043c\u043e\u0434\u0443\u043b\u0435\u0439."}, {"id": "decisions_database_decisions_wallet_vs_datasource", "label": "\u0420\u0435\u0448\u0435\u043d\u0438\u0435 11.4: wallet \u2260 data_source", "file_type": "rationale", "source_file": "app-spec/architecture/decisions/database-decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u0427\u0438\u0441\u0442\u043e\u0435 \u0440\u0430\u0437\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0434\u0435\u043d\u0435\u0433 \u0438 \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u0446\u0438\u0439; \u0441\u0432\u044f\u0437\u044c N:M \u0447\u0435\u0440\u0435\u0437 wallet_data_source."}, {"id": "decisions_database_decisions_three_article_catalogs", "label": "\u0420\u0435\u0448\u0435\u043d\u0438\u0435 11.6: \u0442\u0440\u0438 \u0441\u043f\u0440\u0430\u0432\u043e\u0447\u043d\u0438\u043a\u0430 \u0441\u0442\u0430\u0442\u0435\u0439 + mapping", "file_type": "rationale", "source_file": "app-spec/architecture/decisions/database-decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "dds_article/pnl_line/balance_line \u2014 \u0440\u0430\u0437\u043d\u044b\u0435 \u0443\u0447\u0451\u0442\u043d\u044b\u0435 \u043f\u043b\u043e\u0441\u043a\u043e\u0441\u0442\u0438 cash/accrual/snapshot, \u0441\u0432\u044f\u0437\u044c \u0447\u0435\u0440\u0435\u0437 mapping tables."}, {"id": "decisions_database_decisions_payroll_payment_obligation", "label": "\u0420\u0435\u0448\u0435\u043d\u0438\u0435 11.7: payroll_payment \u2014 \u043e\u0431\u044f\u0437\u0430\u0442\