s-matrix.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u0421\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a \u043c\u043e\u0436\u0435\u0442 \u0432\u0441\u0451 \u0438 \u043e\u0441\u0442\u0430\u0451\u0442\u0441\u044f \u0444\u0438\u043a\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0439 \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c\u044e \u0434\u043e\u0441\u0442\u0443\u043f\u0430 \u0441 \u043f\u043e\u043b\u043d\u044b\u043c \u043d\u0430\u0431\u043e\u0440\u043e\u043c \u043f\u0440\u0430\u0432; \u043d\u0435\u043b\u044c\u0437\u044f \u043e\u0442\u043a\u043b\u044e\u0447\u0438\u0442\u044c \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0433\u043e \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0433\u043e \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a\u0430."}, {"id": "docs_access_rights_matrix_manager", "label": "\u0414\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c \u0434\u043e\u0441\u0442\u0443\u043f\u0430 \u00ab\u0423\u043f\u0440\u0430\u0432\u043b\u044f\u044e\u0449\u0438\u0439\u00bb", "file_type": "concept", "source_file": "docs/access-rights-matrix.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u041f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u0441 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u043b\u043e\u043c \u0438 \u043a\u0443\u0440\u044c\u0435\u0440\u0430\u043c\u0438 \u0438 \u043d\u0435 \u0432\u0438\u0434\u0438\u0442 \u0430\u0434\u043c\u0438\u043d\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u044e \u043d\u0438 \u0447\u0435\u0440\u0435\u0437 \u0441\u043f\u0438\u0441\u043a\u0438, \u043d\u0438 \u0447\u0435\u0440\u0435\u0437 \u043e\u0442\u0447\u0451\u0442\u044b, \u0440\u0430\u0441\u0447\u0451\u0442\u044b, \u0432\u044b