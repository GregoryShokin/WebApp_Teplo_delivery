{"nodes": [{"id": "business_docs_00_index_biznes_dokumentatsiya", "label": "\u0418\u043d\u0434\u0435\u043a\u0441 \u0431\u0438\u0437\u043d\u0435\u0441-\u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0430\u0446\u0438\u0438", "file_type": "document", "source_file": "business-docs/00-index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u041d\u0430\u0432\u0438\u0433\u0430\u0442\u043e\u0440 business-docs: \u043c\u0435\u0442\u043e\u0434\u043e\u043b\u043e\u0433\u0438\u0438, \u0431\u0438\u0437\u043d\u0435\u0441-\u043f\u0440\u0430\u0432\u0438\u043b\u0430, \u043f\u043e\u043b\u0438\u0442\u0438\u043a\u0438 \u0438 \u043f\u043e\u0440\u0442\u0440\u0435\u0442 \u0431\u0438\u0437\u043d\u0435\u0441\u0430, \u0432\u0435\u0440\u043d\u044b\u0435 \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e \u043e\u0442 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u2014 \u00ab\u0447\u0442\u043e\u00bb \u0438 \u00ab\u043f\u043e\u0447\u0435\u043c\u0443\u00bb, \u0430 \u043d\u0435 \u00ab\u043a\u0430\u043a \u0440\u0435\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043d\u043e\u00bb. \u0420\u0430\u0437\u0434\u0435\u043b\u044b: \u043f\u043e\u0440\u0442\u0440\u0435\u0442, \u0444\u0438\u043d\u0430\u043d\u0441\u044b, \u043c\u0430\u0440\u043a\u0435\u0442\u0438\u043d\u0433, \u0448\u0442\u0430\u0442, \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438, \u043a\u043e\u043d\u0442\u0440\u0430\u0433\u0435\u043d\u0442\u044b, \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u043e \u0434\u0430\u043d\u043d\u044b\u0445."}, {"id": "marketing_positioning_pozitsionirovanie", "label": "\u041f\u043e\u0437\u0438\u0446\u0438\u043e\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 (marketing/positioning.md)", "file_type": "document", "source_file": "business-docs/00-index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "marketing_operating_constraints_operatsionnye_ograni